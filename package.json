{
  "name": "kindredcube",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.36",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.24.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@stripe/cli": "^1.43.8",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "local:env": "node script/sync-local-network-env.js",
    "start": "npm run local:env && set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --lan",
    "start:phone": "npm run local:env && set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --lan --clear",
    "start:api": "npm run local:env && cd api && npm.cmd run build && node dist/src/main.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --web --port 3000"
  },
  "private": true
}
